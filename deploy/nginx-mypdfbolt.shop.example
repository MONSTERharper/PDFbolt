# Example nginx site for https://mypdfbolt.shop → PDFbolt on :8080
# Install: sudo cp deploy/nginx-mypdfbolt.shop.example /etc/nginx/sites-available/mypdfbolt.shop
#          sudo ln -sf /etc/nginx/sites-available/mypdfbolt.shop /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name mypdfbolt.shop www.mypdfbolt.shop;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mypdfbolt.shop www.mypdfbolt.shop;

    # ssl_certificate /etc/letsencrypt/live/mypdfbolt.shop/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mypdfbolt.shop/privkey.pem;

    client_max_body_size 60M;

    # AdSense crawls https://mypdfbolt.shop/ads.txt (must not return JSON errors)
    location = /ads.txt {
        proxy_pass http://127.0.0.1:8080/ads.txt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}
