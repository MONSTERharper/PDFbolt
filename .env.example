# HTTP
PORT=8080

# Tool popularity stats (JSON file on disk — no database). Persist with a Docker volume.
# USAGE_STATS_PATH=/data/pdfbolt-tool-usage.json

# JVM (keep modest on t3.micro — 1 GB RAM + swap; Docker image default is 512m max)
JAVA_OPTS=-Xms128m -Xmx384m

# LibreOffice — html-to-pdf, word/powerpoint/excel → PDF (pre-installed in Docker image)
LIBREOFFICE_COMMAND=soffice
LIBREOFFICE_TIMEOUT_SECONDS=120

# Ghostscript — pdf-to-pdfa (pre-installed in Docker image)
GHOSTSCRIPT_COMMAND=gs
GHOSTSCRIPT_TIMEOUT_SECONDS=120

# veraPDF — optional ISO validation after PDF/A conversion (amd64 Docker image; skip on arm64)
VERAPDF_COMMAND=verapdf
PDFA_VALIDATE=true

# PDF → DXF (Python + ezdxf + PyMuPDF; Ghostscript for vector normalization)
PDF_DXF_PYTHON=python3
PDF_DXF_SCRIPT=scripts/pdf_to_dxf.py
PDF_DXF_TIMEOUT_SECONDS=120

# SMTP — Contact page (see src/main/resources/application.properties)
# Gmail: use an App Password for SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace_me
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=you@example.com

# Local dev: log contact inquiries instead of sending email
CONTACT_LOG_ONLY=false
# Inbox for contact form submissions (set in .env only — not committed)
# CONTACT_TO_EMAIL=you@example.com

# Shown on Contact page when the form cannot send (and in site-config API)
SITE_SUPPORT_EMAIL=support@mypdfbolt.shop
SITE_BASE_URL=https://mypdfbolt.shop

# AdSense (banner reads from server — set slot ID from AdSense → Ads → By ad unit)
ADSENSE_ENABLED=true
ADSENSE_CLIENT=ca-pub-3054286166063522
ADSENSE_BANNER_SLOT=5459265290
# ADSENSE_SIDEBAR_SLOT=
# ADSENSE_ADS_TXT_LINE=google.com, pub-3054286166063522, DIRECT, f08c47fec0942fa0

# Optional UI build overrides (new-ui/.env.production) — usually not needed if using server .env above
# VITE_ADSENSE_ENABLED=true
# VITE_ADSENSE_BANNER_SLOT=5459265290
